{
  "manifest_version": 3,
  "name": "OmniGrab 4K - YouTube Downloader",
  "version": "2.2.0",
  "description": "Ultra-sleek 4K YouTube downloader with dynamic quality dropdown, draggable glassmorphism pill, and background tab-independent downloading.",
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "storage",
    "downloads",
    "notifications"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "OmniGrab 4K Downloader",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:19876/*",
    "http://localhost:19876/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
