{
  "manifest_version": 3,
  "name": "TubeGrab - YouTube Video Downloader Extension",
  "version": "2.2.5",
  "description": "Clean, ad-free YouTube video downloader extension with dynamic quality dropdown, live progress bar, and high-speed downloading.",
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "storage",
    "downloads",
    "notifications"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "TubeGrab Downloader",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:19876/*",
    "http://localhost:19876/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["page_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
